# Contact form backend (defaults to https://app.grialink.com if unset)
PUBLIC_BACKEND_URL=https://app.grialink.com

# Mobile app download page (/download): Android always links to
# {PUBLIC_BACKEND_URL}/mobile/download/android (always serves the latest
# uploaded build — see grialink-suite MobileAppBuild). iOS shows "coming soon"
# until this is set to the real App Store listing URL.
PUBLIC_IOS_APP_STORE_URL=

# Analytics (optional — leave empty to disable)
PUBLIC_GA_ID=
PUBLIC_PLAUSIBLE_DOMAIN=

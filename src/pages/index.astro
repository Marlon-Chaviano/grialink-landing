---
import { defaultLang, supportedLanguages } from "@/i18n/config";

/* Build-time: list of supported langs for the inline script */
const langs = JSON.stringify(supportedLanguages);
const fallback = defaultLang;
---

<!doctype html>
<html
	lang={fallback}
	class="dark"
>
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0"
		/>
		<title>Grialink</title>

		<!-- Fallback meta-refresh in case JS is disabled -->
		<meta
			http-equiv="refresh"
			content={`0;url=/${fallback}`}
		/>

		<style>
			/* Scoped critical styles — no external deps needed */
			*,
			*::before,
			*::after {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			body {
				background: #0f1923;
				color: #f1f5f9;
				font-family: system-ui, sans-serif;
				display: flex;
				align-items: center;
				justify-content: center;
				min-height: 100dvh;
				overflow: hidden;
			}

			.loader-wrapper {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 1.5rem;
				animation: fadeIn 0.3s ease-out;
			}

			/* Spinner ring */
			.spinner {
				width: 44px;
				height: 44px;
				border: 3px solid rgba(253, 113, 0, 0.15);
				border-top-color: #fd7100;
				border-radius: 50%;
				animation: spin 0.8s linear infinite;
			}

			.loader-text {
				font-size: 0.875rem;
				color: #94a3b8;
				letter-spacing: 0.025em;
			}

			@keyframes spin {
				to {
					transform: rotate(360deg);
				}
			}

			@keyframes fadeIn {
				from {
					opacity: 0;
					transform: translateY(6px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			/* Respect reduced motion */
			@media (prefers-reduced-motion: reduce) {
				.spinner {
					animation-duration: 1.6s;
				}
				.loader-wrapper {
					animation: none;
				}
			}

			.site-footer {
				position: fixed;
				bottom: 0;
				left: 0;
				right: 0;
				text-align: center;
				padding: 1rem;
				font-size: 0.75rem;
			}
			.site-footer a {
				color: #94a3b8;
				text-decoration: none;
				transition: color 0.2s;
			}
			.site-footer a:hover {
				color: #fd7100;
				text-decoration: underline;
			}
			.site-footer .sep {
				color: #475569;
				margin: 0 0.5rem;
			}
		</style>
	</head>

	<body>
		<div
			class="loader-wrapper"
			role="status"
			aria-live="polite"
		>
			<div
				class="spinner"
				aria-hidden="true"
			>
			</div>
			<p class="loader-text">Cargando…</p>
		</div>

		<footer class="site-footer">
			<a href="/es/privacy">Política de Privacidad</a>
			<span class="sep">·</span>
			<a href="/es/terms">Términos de Servicio</a>
		</footer>

		<script is:inline define:vars={{ langs, fallback }}>
			(function () {
				var supported = JSON.parse(langs);
				var navLang = (navigator.language || navigator.userLanguage || "").split("-")[0].toLowerCase();
				var target = supported.indexOf(navLang) !== -1 ? navLang : fallback;
				window.location.replace("/" + target);
			})();
		</script>
	</body>
</html>

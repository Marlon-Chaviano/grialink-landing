---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import SEO from "@/components/seo/SEO.astro";
import Container from "@/components/ui/Container.astro";
import appIconLight from "@/assets/app/icon-light.png";
import appIconDark from "@/assets/app/icon-dark.png";

import { supportedLanguages, type Lang } from "@/i18n/config";
import { getTranslations } from "@/i18n/utils";

export function getStaticPaths() {
	return supportedLanguages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const download = getTranslations(lang, "download") as Record<string, any>;
const seo = download.seo as Record<string, string>;

const backendUrl = (import.meta.env.PUBLIC_BACKEND_URL?.replace(/\/$/, "") as string) || "https://app.grialink.com";
const androidDownloadUrl = `${backendUrl}/mobile/download/android`;
const iosStoreUrl = (import.meta.env.PUBLIC_IOS_APP_STORE_URL as string) || "";
---

<Layout lang={lang} darkHero>
	<Fragment slot="head">
		<SEO lang={lang} title={seo.title} description={seo.description} />
	</Fragment>

	<main>
		<section class="section-spacing bg-linear-to-br from-[#E06500] via-brand-orange to-brand-red relative overflow-hidden">
			<div class="absolute inset-0 pointer-events-none" aria-hidden="true">
				<div class="absolute top-0 left-1/4 w-96 h-96 bg-white/10 rounded-full blur-[120px]"></div>
				<div class="absolute bottom-0 right-1/4 w-80 h-80 bg-accent/15 rounded-full blur-[100px]"></div>
			</div>

			<Container class="relative z-10 text-center">
				<div class="max-w-2xl mx-auto">
					<span
						class="inline-block mb-4 text-xs font-semibold uppercase tracking-wide text-white/70"
						data-animate
					>
						{download.hero.eyebrow}
					</span>

					<div class="mx-auto mb-6 w-24 h-24 rounded-[22%] overflow-hidden shadow-2xl shadow-black/30 ring-1 ring-white/20" data-animate>
						<Image
							src={appIconDark}
							alt="Grialink"
							class="dark-only w-full h-full object-cover"
							width={96}
							height={96}
						/>
						<Image
							src={appIconLight}
							alt="Grialink"
							class="light-only w-full h-full object-cover"
							width={96}
							height={96}
						/>
					</div>

					<h1
						class="text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-5 tracking-tight leading-[1.1]"
						data-animate
					>
						{download.hero.heading}
					</h1>
					<p class="text-lg text-white/70 mb-10 max-w-xl mx-auto leading-relaxed" data-animate>
						{download.hero.subtitle}
					</p>

					<div class="flex flex-col sm:flex-row gap-4 justify-center" data-animate>
						{
							iosStoreUrl ? (
								<a
									href={iosStoreUrl}
									data-cta="download-ios"
									class="group inline-flex min-h-14 items-center justify-center gap-3 bg-white text-primary font-semibold px-7 py-3.5 rounded-full transition-all duration-300 ease-in-out shadow-xl hover:shadow-2xl hover:-translate-y-0.5"
								>
									<svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
										<path d="M16.365 1.43c0 1.14-.437 2.093-1.309 2.856-.998.87-2.116 1.256-3.351 1.157-.113-1.096.32-2.13 1.187-3.001.883-.9 2.111-1.442 3.473-1.512Zm3.6 16.66c-.484 1.114-.734 1.605-1.373 2.585-.891 1.36-2.149 3.055-3.708 3.07-1.386.014-1.743-.897-3.624-.886-1.882.01-2.276.9-3.663.886-1.558-.015-2.75-1.545-3.641-2.905-2.494-3.804-2.756-8.27-1.216-10.65.093-1.68.72-2.98.72-3 1.2-.752 2.393-.855 3.293-.855 1.13 0 2.2.782 2.9.782.68 0 1.98-.968 3.34-.826.57.024 2.17.23 3.2 1.734-.083.052-1.91 1.116-1.888 3.33.024 2.646 2.32 3.53 2.345 3.542a8.42 8.42 0 0 1-.685 1.593Z" />
									</svg>
									{download.ios.label}
								</a>
							) : (
								<span
									data-testid="ios-coming-soon"
									class="inline-flex min-h-14 items-center justify-center gap-3 border border-white/30 text-white/70 font-medium px-7 py-3.5 rounded-full"
								>
									{download.ios.comingSoon}
								</span>
							)
						}

						<a
							href={androidDownloadUrl}
							data-cta="download-android"
							class="group inline-flex min-h-14 items-center justify-center gap-3 bg-white text-primary font-semibold px-7 py-3.5 rounded-full transition-all duration-300 ease-in-out shadow-xl hover:shadow-2xl hover:-translate-y-0.5"
						>
							<svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M17.523 15.34a1.09 1.09 0 1 1 1.09-1.09 1.09 1.09 0 0 1-1.09 1.09m-11.046 0a1.09 1.09 0 1 1 1.09-1.09 1.09 1.09 0 0 1-1.09 1.09m11.405-6.02 2.18-3.775a.454.454 0 1 0-.786-.454l-2.207 3.822a13.6 13.6 0 0 0-11.35 0L3.512 5.09a.454.454 0 1 0-.786.454l2.18 3.776C1.892 11.4 0 14.5 0 18h24c0-3.5-1.892-6.6-4.882-8.68" />
							</svg>
							{download.android.label}
						</a>
					</div>
					<p class="mt-6 text-xs text-white/60 max-w-md mx-auto leading-relaxed" data-animate>
						{download.android.note}
					</p>
				</div>
			</Container>
		</section>

		<section class="section-spacing bg-background text-center" data-animate>
			<Container>
				<h2 class="mb-2 text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
					{download.loggedIn.heading}
				</h2>
				<p class="mx-auto max-w-md text-sm text-muted-foreground sm:text-base">
					{download.loggedIn.subtitle}
				</p>
			</Container>
		</section>
	</main>
</Layout>

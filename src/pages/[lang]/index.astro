---
import Layout from "@/layouts/Layout.astro";
import SEO from "@/components/seo/SEO.astro";
import Hero from "@/components/sections/Hero.astro";
import LogoCloud from "@/components/sections/LogoCloud.astro";
import Problem from "@/components/sections/Problem.astro";
import ProductPillars from "@/components/sections/ProductPillars.astro";
import ProductSpotlight from "@/components/sections/ProductSpotlight.astro";
import RoleFeatures from "@/components/sections/RoleFeatures.astro";
import HowItWorks from "@/components/sections/HowItWorks.astro";
import TrustBadges from "@/components/sections/TrustBadges.astro";
import PricingTeaser from "@/components/sections/PricingTeaser.astro";
import HomeFAQ from "@/components/sections/HomeFAQ.astro";
import MobileAppTeaser from "@/components/sections/MobileAppTeaser.astro";
import CTA from "@/components/sections/CTA.astro";

import { supportedLanguages, type Lang } from "@/i18n/config";
import { useTranslations, getTranslations } from "@/i18n/utils";

export function getStaticPaths() {
	return supportedLanguages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const faq = getTranslations(lang, "homeFaq") as {
	items: { question: string; answer: string }[];
};
const siteUrl = "https://grialink.com";
---

<Layout lang={lang} darkHero>
	<Fragment slot="head">
		<SEO
			lang={lang}
			title={t("seo.title")}
			description={t("seo.description")}
			page="home"
		/>
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "Organization",
				name: "Grialink",
				legalName: "Ezi Group LLC",
				url: siteUrl,
				logo: `${siteUrl}/logo.png`,
				email: "info@grialink.com",
				description: t("seo.description"),
				contactPoint: {
					"@type": "ContactPoint",
					email: "info@grialink.com",
					contactType: "customer service",
					availableLanguage: ["English", "Spanish"],
				},
				sameAs: [],
			})}
		/>
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "FAQPage",
				mainEntity: faq.items.map((item) => ({
					"@type": "Question",
					name: item.question,
					acceptedAnswer: { "@type": "Answer", text: item.answer },
				})),
			})}
		/>
	</Fragment>

	<main>
		{/*
		  Section order is an argument, not a list. Each one answers the next
		  question a visitor has:
		    Hero            — what is this?
		    LogoCloud       — does it work with what I already run?
		    Problem         — do you understand my day?
		    ProductPillars  — what exactly do I get?
		    Spotlight ×2    — show me the two that matter most
		    RoleFeatures    — is this for someone in my job?
		    HowItWorks      — how much work is it to start?
		    TrustBadges     — is my data safe?
		    PricingTeaser   — what does it cost?
		    FAQ / CTA       — anything left, then the ask.

		  A `Testimonial` slot belongs between the two spotlights (proof right
		  after the claim). It is left out until there are real quotes to put in
		  it — see the header comment in `Testimonial.astro`.
		*/}
		<Hero lang={lang} />
		<LogoCloud lang={lang} />
		<Problem lang={lang} />
		<ProductPillars lang={lang} />
		<ProductSpotlight lang={lang} product="whatsappCopilot" href="/products/whatsapp-copilot" tinted />
		<ProductSpotlight lang={lang} product="frontDesk" href="/products/grial-front-desk" reverse />
		<RoleFeatures lang={lang} />
		<HowItWorks lang={lang} />
		<TrustBadges lang={lang} variant="standalone" />
		<PricingTeaser lang={lang} />
		<MobileAppTeaser lang={lang} />
		<HomeFAQ lang={lang} />
		<CTA lang={lang} />
	</main>
</Layout>

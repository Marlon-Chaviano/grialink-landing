---
/**
 * Site-wide circuit backdrop. Thin wrapper over `CircuitAtmosphere` so pages keep
 * the existing `circuitVariant` API while the rendering lives in one place.
 */
import CircuitAtmosphere from './CircuitAtmosphere.astro';

interface Props {
	/** hero: lateral traces only (default). full: adds the centre horizontal seam (pricing). */
	variant?: 'hero' | 'full';
}

const { variant = 'hero' } = Astro.props;
---

{/*
  Kept subtle on purpose: this layer sits behind body copy for the whole page,
  so at full strength the traces compete with the text. Heroes, dividers and CTA
  panels opt into stronger `CircuitAtmosphere` instances of their own.
*/}
<CircuitAtmosphere variant="page" intensity="subtle" seam={variant === 'full'} />

---
/**
 * AIImpact — where AI actually shows up in the product.
 *
 * Previously a 546-line React island that hand-built fake dashboards. Now it
 * shows the real screens and the tabs run on native radio inputs, so the
 * section ships zero JavaScript and stays keyboard-navigable for free.
 */
import Container from "@/components/ui/Container.astro";
import ProductPreview from "@/components/ui/ProductPreview.astro";
import { type Lang, localizedHref } from "@/i18n/config";
import { getTranslations } from "@/i18n/utils";

import copilotDark from "@/assets/marketing/captures/inbox-thread-dark.webp";
import copilotLight from "@/assets/marketing/captures/inbox-thread-light.webp";
import callsDark from "@/assets/marketing/captures/call-intelligence-dark.webp";
import callsLight from "@/assets/marketing/captures/call-intelligence-light.webp";
import insightsDark from "@/assets/marketing/captures/sales-insights-dark.webp";
import insightsLight from "@/assets/marketing/captures/sales-insights-light.webp";
import crmDark from "@/assets/marketing/captures/crm-analytics-dark.webp";
import crmLight from "@/assets/marketing/captures/crm-analytics-light.webp";
import prospectorDark from "@/assets/marketing/captures/prospector-smart-dark.webp";
import prospectorLight from "@/assets/marketing/captures/prospector-smart-light.webp";

interface Feature {
	id: string;
	label: string;
	tagline: string;
	description: string;
	alt: string;
}

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const ai = getTranslations(lang, "aiImpact") as Record<string, unknown>;
const features = ai.features as Feature[];

const shots: Record<string, { dark: ImageMetadata; light: ImageMetadata }> = {
	copilot: { dark: copilotDark, light: copilotLight },
	calls: { dark: callsDark, light: callsLight },
	insights: { dark: insightsDark, light: insightsLight },
	crm: { dark: crmDark, light: crmLight },
	prospector: { dark: prospectorDark, light: prospectorLight },
};

/**
 * `group-has-[…]` rather than `peer-…`: the labels sit one level below the
 * radios, and `peer` only reaches siblings — it would switch the panels but
 * leave the active pill unmarked. Tailwind needs these as literal strings.
 *
 * Keyed by feature id, not by index: inserting a tab in the middle of the i18n
 * list silently mismatched the pill highlight against the panel when these were
 * positional arrays.
 */
const LABEL_ON: Record<string, string> = {
	copilot: "group-has-[#ai-impact-copilot:checked]:border-primary/40 group-has-[#ai-impact-copilot:checked]:bg-primary/10 group-has-[#ai-impact-copilot:checked]:text-primary",
	calls: "group-has-[#ai-impact-calls:checked]:border-primary/40 group-has-[#ai-impact-calls:checked]:bg-primary/10 group-has-[#ai-impact-calls:checked]:text-primary",
	insights: "group-has-[#ai-impact-insights:checked]:border-primary/40 group-has-[#ai-impact-insights:checked]:bg-primary/10 group-has-[#ai-impact-insights:checked]:text-primary",
	crm: "group-has-[#ai-impact-crm:checked]:border-primary/40 group-has-[#ai-impact-crm:checked]:bg-primary/10 group-has-[#ai-impact-crm:checked]:text-primary",
	prospector: "group-has-[#ai-impact-prospector:checked]:border-primary/40 group-has-[#ai-impact-prospector:checked]:bg-primary/10 group-has-[#ai-impact-prospector:checked]:text-primary",
};
const PANEL_ON: Record<string, string> = {
	copilot: "group-has-[#ai-impact-copilot:checked]:block",
	calls: "group-has-[#ai-impact-calls:checked]:block",
	insights: "group-has-[#ai-impact-insights:checked]:block",
	crm: "group-has-[#ai-impact-crm:checked]:block",
	prospector: "group-has-[#ai-impact-prospector:checked]:block",
};
const FOCUS_RING: Record<string, string> = {
	copilot: "group-has-[#ai-impact-copilot:focus-visible]:ring-2 group-has-[#ai-impact-copilot:focus-visible]:ring-primary/40",
	calls: "group-has-[#ai-impact-calls:focus-visible]:ring-2 group-has-[#ai-impact-calls:focus-visible]:ring-primary/40",
	insights: "group-has-[#ai-impact-insights:focus-visible]:ring-2 group-has-[#ai-impact-insights:focus-visible]:ring-primary/40",
	crm: "group-has-[#ai-impact-crm:focus-visible]:ring-2 group-has-[#ai-impact-crm:focus-visible]:ring-primary/40",
	prospector: "group-has-[#ai-impact-prospector:focus-visible]:ring-2 group-has-[#ai-impact-prospector:focus-visible]:ring-primary/40",
};
---

<section
	id="ai-impact"
	class="section-spacing relative overflow-hidden bg-background-lighter text-foreground"
>
	<Container>
		<div class="mx-auto mb-10 max-w-3xl text-center lg:mb-14" data-animate>
			<h2 class="mb-4 text-display-sm font-bold tracking-display text-balance">
				{ai.headingLine1 as string}
				<span class="text-primary">{ai.headingLine2 as string}</span>
			</h2>
			<p class="mx-auto max-w-2xl text-base leading-relaxed text-muted-foreground lg:text-lg">
				{ai.subtitle as string}
			</p>
		</div>

		{/* Radios first: Tailwind peer variants only reach later siblings. */}
		<div class="group" data-animate role="radiogroup" aria-label={ai.subtitle as string}>
			{
				features.map((feature, i) => (
					<input
						type="radio"
						name="ai-impact-tab"
						id={`ai-impact-${feature.id}`}
						class="sr-only"
						checked={i === 0}
					/>
				))
			}

			<div class="mb-10 flex flex-wrap justify-center gap-2">
				{
					features.map((feature) => (
						<label
							for={`ai-impact-${feature.id}`}
							class:list={[
								"cursor-pointer rounded-full border border-border-light px-4 py-2 text-sm font-medium text-muted-foreground transition-colors duration-200 hover:border-primary/30 hover:text-foreground",
								LABEL_ON[feature.id],
								FOCUS_RING[feature.id],
							]}
						>
							{feature.label}
						</label>
					))
				}
			</div>

			{
				features.map((feature) => (
					<div class:list={["hidden", PANEL_ON[feature.id]]}>
						<div class="mx-auto mb-8 max-w-2xl text-center">
							<p class="text-lg font-semibold text-foreground">{feature.tagline}</p>
							<p class="mt-2 text-sm leading-relaxed text-muted-foreground lg:text-base">
								{feature.description}
							</p>
						</div>
						<ProductPreview
							dark={shots[feature.id].dark}
							light={shots[feature.id].light}
							alt={feature.alt}
							class="mx-auto max-w-5xl"
						/>
					</div>
				))
			}
		</div>

		<div class="mt-12 text-center" data-animate>
			<a
				class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-primary/25 bg-primary/5 px-5 py-2.5 text-sm font-semibold text-primary transition-colors duration-200 hover:border-primary/40 hover:bg-primary/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"
				href={localizedHref("/products", lang)}
			>
				{ai.exploreLink as string}
				<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M17 8l4 4m0 0l-4 4m4-4H3"
					/>
				</svg>
			</a>
		</div>
	</Container>
</section>

---
/**
 * TrustBadges — Security section aligned with app onboarding plans page.
 */
import Container from "@/components/ui/Container.astro";
import { type Lang } from "@/i18n/config";
import { getTranslations } from "@/i18n/utils";

interface Props {
	lang: Lang;
	/** standalone: full home section with heading. pricing: embedded under pricing plans. */
	variant?: "pricing" | "standalone";
}

const { lang, variant = "pricing" } = Astro.props;
const p = getTranslations(lang, "pricing") as Record<string, any>;
const trust = p.trust as Record<string, string>;

const badges = [
	{ key: "hipaa", icon: "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10ZM9 12l2 2 4-4", color: "text-green-500" },
	{ key: "soc2", icon: "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10ZM9 12l2 2 4-4", color: "text-primary" },
	{ key: "gdpr", icon: "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20ZM2 12h20", color: "text-muted-foreground" },
] as const;
---

<section
	class:list={[variant === "standalone" ? "section-spacing bg-background" : "mb-14 text-center"]}
	data-animate
>
	<Container class:list={[variant === "standalone" ? "text-center" : ""]}>
		{
			variant === "standalone" ? (
				<h2 class="mb-8 text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
					{trust.title}
				</h2>
			) : (
				<p class="mb-6 text-sm font-medium text-muted-foreground">{trust.title}</p>
			)
		}
		<div class="flex flex-wrap items-center justify-center gap-4 md:gap-6">
			{
				badges.map((badge) => (
					<div class="flex items-center gap-2 rounded-lg border border-border-light bg-surface px-4 py-2">
						<svg
							class:list={["h-5 w-5", badge.color]}
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							viewBox="0 0 24 24"
							aria-hidden="true"
						>
							<path d={badge.icon} />
						</svg>
						<span class="text-sm font-medium text-muted-foreground">{trust[badge.key]}</span>
					</div>
				))
			}
			<div class="flex items-center gap-2 rounded-lg border border-border-light bg-surface px-4 py-2">
				<svg
					class="h-5 w-5 text-amber-500"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<path d="M19 11H5a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2ZM7 11V7a5 5 0 0 1 10 0v4" />
				</svg>
				<div>
					<span class="text-sm font-medium text-muted-foreground">{trust.encryption}</span>
					<span class="ml-1 text-xs text-muted-foreground/70">({trust.encryptionDesc})</span>
				</div>
			</div>
		</div>
	</Container>
</section>

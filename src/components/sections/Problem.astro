---
/**
 * Problem — the empathy beat before the product appears.
 *
 * Deliberately card-free: three pains read as an editorial list so the section
 * carries weight through type and rhythm rather than another row of boxes.
 */
import Container from "@/components/ui/Container.astro";
import { type Lang } from "@/i18n/config";
import { getTranslations } from "@/i18n/utils";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslations(lang, "problem") as {
	title: string;
	subtitle: string;
	items: { title: string; description: string }[];
};
---

<section class="section-spacing relative overflow-hidden" id="problem">
	<Container>
		<div class="grid gap-x-16 gap-y-12 lg:grid-cols-[minmax(0,26rem)_minmax(0,1fr)]">
			<div class="lg:sticky lg:top-32 lg:self-start" data-animate>
				<h2 class="text-display-sm font-bold tracking-display text-foreground text-balance">
					{t.title}
				</h2>
				<p class="mt-5 text-base leading-relaxed text-muted-foreground lg:text-lg">
					{t.subtitle}
				</p>
			</div>

			<ol class="stagger-children border-t border-border-light" data-animate>
				{
					t.items.map((item, i) => (
						<li class="group border-b border-border-light py-7 lg:py-9">
							<div class="flex gap-6">
								<span
									class="mt-1 shrink-0 text-sm font-semibold tabular-nums text-primary/60 transition-colors duration-300 group-hover:text-primary"
									aria-hidden="true"
								>
									{String(i + 1).padStart(2, "0")}
								</span>
								<div class="min-w-0">
									<h3 class="text-lg font-semibold text-foreground lg:text-xl">{item.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-muted-foreground lg:text-base">
										{item.description}
									</p>
								</div>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</Container>
</section>

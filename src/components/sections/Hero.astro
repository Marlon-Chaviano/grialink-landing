---
/**
 * Home hero.
 *
 * Outcome-led hero: the practice is calm and ready for clients while Grialink
 * handles the conversations behind it. The custom photograph was composed with
 * negative space for copy, so it remains the protagonist rather than being
 * covered by a product screenshot.
 */
import { Image } from "astro:assets";
import Container from "@/components/ui/Container.astro";
import CircuitAtmosphere from "@/components/background/CircuitAtmosphere.astro";
import heroAtmosphere from "@/assets/marketing/hero-reception.webp";
import { type Lang } from "@/i18n/config";
import { useTranslations } from "@/i18n/utils";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const registerHref = "https://app.grialink.com/app/auth/register";
---

<section class="relative isolate min-h-[100svh] overflow-hidden pt-24 lg:pt-28">
	{/* Full-bleed visual plane */}
	<div class="absolute inset-0 -z-20 bg-[#080d12]">
		<Image
			src={heroAtmosphere}
			alt=""
			class="h-full w-full object-cover object-[78%_center] opacity-65 sm:object-[72%_center] sm:opacity-80 lg:object-center lg:opacity-100"
			widths={[640, 960, 1280, 1920]}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
		/>
		<div
			class="absolute inset-0 bg-[#080d12]/35 sm:bg-transparent"
			aria-hidden="true"
		>
		</div>
		<div
			class="absolute inset-0 bg-gradient-to-r from-[#080d12] from-0% via-[#080d12]/95 via-48% to-[#080d12]/10 to-100%"
			aria-hidden="true"
		>
		</div>
		<div class="absolute inset-0 bg-gradient-to-t from-[#080d12] via-transparent to-[#080d12]/50" aria-hidden="true"></div>
	</div>

	{/* Brand circuitry sits over the photograph but behind the message. */}
    <CircuitAtmosphere variant="hero" intensity="subtle" />
	<div
		class="pointer-events-none absolute -right-24 top-[16%] -z-10 h-64 w-64 rounded-full bg-destructive/12 blur-[100px]"
		aria-hidden="true"
	></div>
	<div
		class="pointer-events-none absolute bottom-[8%] right-[18%] -z-10 h-44 w-44 rounded-full bg-accent/10 blur-[90px]"
		aria-hidden="true"
	></div>

	<Container
		class="relative flex min-h-[calc(100svh-6rem)] flex-col justify-center pb-20 pt-8 lg:min-h-[calc(100svh-7rem)] lg:pb-28"
	>
		<div class="max-w-2xl" data-animate>
				<p
					class="mb-5 inline-flex items-center rounded-full border border-primary/25 bg-primary/10 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider text-primary"
				>
					{t("hero.badge")}
				</p>

				<h1 class="mb-5 text-display-lg font-black tracking-display-tight text-white">
					{t("hero.titleLine1")}
					<br class="hidden sm:block" />
					<span class="text-gradient-primary">{t("hero.titleHighlight")}</span>
				</h1>

				<p class="mb-8 max-w-xl text-base leading-relaxed text-slate-300 sm:text-lg">
					{t("hero.subtitle")}
				</p>

				<div class="flex flex-col gap-3 sm:flex-row sm:items-center">
					<a
						href={registerHref}
						data-cta="register-hero"
						class="group inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-full bg-primary px-7 py-3.5 text-base font-semibold text-primary-foreground shadow-lg shadow-primary/25 transition-all duration-300 ease-in-out hover:bg-primary-hover hover:shadow-xl hover:shadow-primary/35 active:scale-[0.98] sm:w-auto"
					>
						{t("hero.ctaPrimary")}
						<svg
							class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
							aria-hidden="true"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M17 8l4 4m0 0l-4 4m4-4H3"
							></path>
						</svg>
					</a>
					<a
						href="#products"
						class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-full border border-white/15 bg-white/5 px-7 py-3.5 text-base font-medium text-white backdrop-blur-sm transition-all duration-300 ease-in-out hover:border-primary/40 hover:bg-white/10 active:scale-[0.98] sm:w-auto"
					>
						{t("hero.ctaSecondary")}
					</a>
				</div>

				<p class="mt-5 text-xs text-slate-400 sm:text-sm">{t("hero.disclaimer")}</p>
		</div>
	</Container>
</section>

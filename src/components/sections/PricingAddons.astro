---
/**
 * PricingAddons — Add-on pills (matches app onboarding plans page).
 */
import Container from "@/components/ui/Container.astro";
import { type Lang } from "@/i18n/config";
import { getTranslations } from "@/i18n/utils";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const p = getTranslations(lang, "pricing") as Record<string, any>;
const addons = p.addons as Record<string, string | string[]>;
const pills = addons.pills as string[];
---

<section class="mb-14 text-center" data-animate>
	<Container>
		<h3 class="mb-2 text-base font-bold text-foreground">{addons.title}</h3>
		<p class="mx-auto mb-6 max-w-lg text-xs text-muted-foreground">{addons.subtitle}</p>
		<div class="mx-auto flex max-w-3xl flex-wrap justify-center gap-2">
			{
				pills.map((pill) => (
					<span class="inline-flex items-center rounded-full border border-border-light bg-surface px-3 py-1.5 text-xs font-medium text-muted-foreground">
						{pill}
					</span>
				))
			}
		</div>
	</Container>
</section>

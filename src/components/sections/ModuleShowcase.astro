---
/**
 * ModuleShowcase — one module, one real screen.
 *
 * Replaces seven hand-rolled sections that each rebuilt their own layout and,
 * for the modules without a capture, drew fake app chrome from invented KPIs.
 * Every module now follows the same rhythm and shows its actual screen.
 */
import { Image } from "astro:assets";
import Container from "@/components/ui/Container.astro";
import ProductPreview from "@/components/ui/ProductPreview.astro";

interface Props {
	/** Anchor target used by the module grid and the nav. */
	id: string;
	badge: string;
	title: string;
	subtitle: string;
	featuresTitle: string;
	featuresDescription: string;
	features: string[];
	alt: string;
	dark: ImageMetadata;
	light: ImageMetadata;
	/** Alternates the section background so seven modules don't read as one block. */
	tinted?: boolean;
	/**
	 * Optional photographs shown above the screen. Some modules are easier to
	 * grasp from a scene than from an interface — the AI receptionist reads as
	 * "it answers when nobody is there" long before an IVR tree does.
	 */
	atmosphere?: { src: ImageMetadata; alt: string }[];
}

const {
	id,
	badge,
	title,
	subtitle,
	featuresTitle,
	featuresDescription,
	features,
	alt,
	dark,
	light,
	tinted = false,
	atmosphere = [],
} = Astro.props;
---

<section
	id={id}
	class:list={[
		"section-spacing relative scroll-mt-28 overflow-hidden",
		tinted ? "bg-secondary/40" : "bg-background",
	]}
>
	<Container>
		<div class="mx-auto mb-12 max-w-3xl text-center lg:mb-16" data-animate>
			<p
				class="mb-4 inline-flex items-center rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-primary"
			>
				{badge}
			</p>
			<h2 class="mb-4 text-display-sm font-bold tracking-display text-foreground text-balance">
				{title}
			</h2>
			<p class="text-base leading-relaxed text-muted-foreground lg:text-lg">{subtitle}</p>
		</div>

		{
			atmosphere.length > 0 && (
				<div
					class:list={[
						"mx-auto mb-10 grid max-w-5xl gap-4",
						atmosphere.length > 1 && "sm:grid-cols-2",
					]}
					data-animate
				>
					{atmosphere.map((shot) => (
						<Image
							src={shot.src}
							alt={shot.alt}
							class="h-full w-full rounded-xl object-cover ring-1 ring-border-light lg:rounded-2xl"
							widths={[480, 720, 1080]}
							sizes="(min-width: 1280px) 520px, (min-width: 640px) 45vw, 100vw"
							loading="lazy"
						/>
					))}
				</div>
			)
		}

		{/*
		  The capture runs full width rather than sitting in a half column: these
		  are dense dashboards, and at ~580px the interface text is unreadable —
		  which defeats the point of showing the real screen.
		*/}
		<ProductPreview dark={dark} light={light} alt={alt} class="mx-auto max-w-5xl" />

		<div
			class="mx-auto mt-14 grid max-w-5xl gap-x-12 gap-y-8 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)]"
			data-animate
		>
			<div>
				<h3 class="text-xl font-semibold text-foreground lg:text-2xl text-balance">
					{featuresTitle}
				</h3>
				<p class="mt-3 leading-relaxed text-muted-foreground">{featuresDescription}</p>
			</div>

			<ul class="grid gap-x-8 gap-y-3.5 sm:grid-cols-2">
				{
					features.map((feature) => (
						<li class="flex items-start gap-3 text-sm leading-relaxed text-muted-foreground">
							<svg
								class="mt-0.5 h-4 w-4 shrink-0 text-primary"
								fill="none"
								stroke="currentColor"
								stroke-width="2.5"
								stroke-linecap="round"
								stroke-linejoin="round"
								viewBox="0 0 24 24"
								aria-hidden="true"
							>
								<path d="M20 6 9 17l-5-5" />
							</svg>
							<span>{feature}</span>
						</li>
					))
				}
			</ul>
		</div>
	</Container>
</section>

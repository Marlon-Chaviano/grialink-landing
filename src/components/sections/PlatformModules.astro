---
/**
 * PlatformModules — home preview of all 7 product modules (uniform grid).
 */
import Container from "@/components/ui/Container.astro";
import ModuleArchitectureCard from "@/components/sections/ModuleArchitectureCard.astro";
import { type Lang, localizedHref } from "@/i18n/config";
import { getTranslations } from "@/i18n/utils";
import { products } from "@/lib/products";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const section = getTranslations(lang, "platformModules") as Record<string, string>;
const productTranslations = getTranslations(lang, "productsPage").products as Record<
	string,
	{ name: string; description: string; highlight?: string }
>;

const lastAlone = products.length % 3 === 1;
---

<section id="platform-modules" class="section-spacing bg-background">
	<Container>
		<div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14" data-animate>
			<h2 class="mb-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
				{section.title}
			</h2>
			<p class="text-base leading-relaxed text-muted-foreground lg:text-lg">
				{section.subtitle}
			</p>
		</div>

		<div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3 xl:gap-5">
			{
				products.map((product, index) => {
					const t = productTranslations[product.id];
					const centerLast = lastAlone && index === products.length - 1;
					return (
						<div
							class:list={[centerLast && "xl:col-span-3 xl:flex xl:justify-center"]}
						>
							<ModuleArchitectureCard
								lang={lang}
								product={product}
								name={t.name}
								description={t.description}
								highlight={t.highlight}
								viewLabel={section.viewModule}
								class:list={[centerLast && "xl:w-full xl:max-w-md"]}
							/>
						</div>
					);
				})
			}
		</div>

		<div class="mt-10 text-center" data-animate>
			<a
				href={localizedHref(section.ctaHref ?? "/products", lang)}
				class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-primary/25 bg-primary/5 px-5 py-2.5 text-sm font-semibold text-primary transition-colors duration-200 hover:border-primary/40 hover:bg-primary/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"
			>
				{section.cta}
				<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M17 8l4 4m0 0l-4 4m4-4H3"
					/>
				</svg>
			</a>
		</div>
	</Container>
</section>

---
/**
 * ProductsGrid — modular product cards (architecture section on /products).
 */
import Container from "@/components/ui/Container.astro";
import ModuleArchitectureCard from "@/components/sections/ModuleArchitectureCard.astro";
import { type Lang } from "@/i18n/config";
import { getTranslations } from "@/i18n/utils";
import { productGridOnlyAnchors, products } from "@/lib/products";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const p = getTranslations(lang, "productsPage") as Record<string, unknown>;
const grid = p.grid as Record<string, string>;
const productTranslations = p.products as Record<
	string,
	{ name: string; description: string; highlight?: string }
>;

const lastAlone = products.length % 3 === 1;
---

<section class="section-spacing scroll-mt-28 bg-background-lighter" id="ecosystem">
	<Container>
		<div class="mx-auto mb-12 max-w-2xl text-center lg:mb-16" data-animate>
			<h2 class="mb-4 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
				{grid.title}
			</h2>
			<p class="text-lg leading-relaxed text-muted-foreground">
				{grid.subtitle}
			</p>
		</div>

		<div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3 xl:gap-5">
			{
				products.map((product, index) => {
					const t = productTranslations[product.id];
					const centerLast = lastAlone && index === products.length - 1;
					return (
						<div
							class:list={[centerLast && "xl:col-span-3 xl:flex xl:justify-center"]}
						>
							<ModuleArchitectureCard
								lang={lang}
								product={product}
								name={t.name}
								description={t.description}
								highlight={t.highlight}
								viewLabel={grid.viewDetails}
								scrollTargetId={
									productGridOnlyAnchors.has(product.slug) ? product.slug : undefined
								}
								class:list={[centerLast && "xl:w-full xl:max-w-md"]}
							/>
						</div>
					);
				})
			}
		</div>
	</Container>
</section>

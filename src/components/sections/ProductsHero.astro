---
/**
 * ProductsHero — outcome-focused hero with a real product screen + register CTA.
 *
 * The previous version autoplayed a 27 MB MP4 here, roughly thirteen times the
 * whole page budget and the first thing the browser fetched. A real capture
 * tells the same story, matches the rest of the page, and costs ~50 KB.
 */
import Container from "@/components/ui/Container.astro";
import ProductPreview from "@/components/ui/ProductPreview.astro";
import inboxDark from "@/assets/marketing/captures/inbox-dark.webp";
import inboxLight from "@/assets/marketing/captures/inbox-light.webp";
import { type Lang, localizedHref } from "@/i18n/config";
import { getTranslations } from "@/i18n/utils";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const p = getTranslations(lang, "productsPage") as Record<string, any>;
const hero = p.hero as Record<string, any>;
const registerHref = "https://app.grialink.com/app/auth/register";
---

<section class="relative overflow-hidden pt-28 pb-16 lg:pt-36 lg:pb-24">
	<div
		class="pointer-events-none absolute inset-0"
		aria-hidden="true"
		style="background-image: radial-gradient(at 40% 20%, rgba(253,113,0,0.1) 0px, transparent 50%), radial-gradient(at 80% 0%, rgba(253,113,0,0.04) 0px, transparent 50%);"
	>
	</div>

	<Container class="relative z-10">
		<div class="mx-auto mb-12 max-w-3xl text-center" data-animate>
			<p
				class="mb-6 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-primary"
			>
				<span class="h-2 w-2 animate-pulse rounded-full bg-primary" aria-hidden="true"></span>
				{hero.badge}
			</p>

			<h1
				class="mb-6 text-4xl font-extrabold leading-[1.08] tracking-tight text-foreground sm:text-5xl md:text-6xl"
			>
				{hero.titleLine1}
				<br class="hidden md:block" />
				<span class="text-gradient-primary">{hero.titleHighlight}</span>
			</h1>

			<p class="mx-auto mb-8 max-w-2xl text-lg leading-relaxed text-muted-foreground">
				{hero.subtitle}
			</p>

			<div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
				<a
					href={registerHref}
					data-cta="register-products-hero"
					class="inline-flex min-h-12 w-full items-center justify-center rounded-full bg-primary px-7 py-3.5 text-base font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all duration-300 ease-in-out hover:bg-primary-hover sm:w-auto"
				>
					{hero.ctaPrimary}
				</a>
				<a
					href={localizedHref("/pricing", lang)}
					class="inline-flex min-h-12 w-full items-center justify-center rounded-full border border-border-light px-7 py-3.5 text-base font-medium text-muted-foreground transition-all duration-300 ease-in-out hover:border-primary/25 hover:text-foreground sm:w-auto"
				>
					{hero.ctaSecondary}
				</a>
			</div>
		</div>

		<ProductPreview
			dark={inboxDark}
			light={inboxLight}
			alt={hero.previewAlt}
			eager
			class="mx-auto max-w-5xl"
		/>
	</Container>
</section>

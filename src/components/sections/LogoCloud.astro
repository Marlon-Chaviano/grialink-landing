---
import Container from "@/components/ui/Container.astro";
import ApolloWordmark from "@/components/ui/ApolloWordmark.astro";
import { type Lang } from "@/i18n/config";
import { useTranslations } from "@/i18n/utils";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

type ColoredBrand = { name: string; kind: "colored"; icon: string };
type ThemeBrand = { name: string; kind: "theme"; iconDark: string; iconLight: string };
type ApolloBrand = { name: string; kind: "apollo" };

/** Brand marks — local SVGs where Simple Icons CDN no longer hosts the brand */
const integrations: Array<ColoredBrand | ThemeBrand | ApolloBrand> = [
	{ name: "WhatsApp", kind: "colored", icon: "https://cdn.simpleicons.org/whatsapp/25D366" },
	{
		name: "Google Calendar",
		kind: "theme",
		iconDark: "https://cdn.simpleicons.org/googlecalendar/ffffff",
		iconLight: "https://cdn.simpleicons.org/googlecalendar/4285F4",
	},
	{ name: "Meta Ads", kind: "colored", icon: "https://cdn.simpleicons.org/meta/1877F2" },
	{ name: "Apollo", kind: "apollo" },
	{ name: "Twilio", kind: "colored", icon: "/assets/integrations/twilio.svg" },
	{ name: "SendGrid", kind: "colored", icon: "/assets/integrations/sendgrid.svg" },
];
---

<section class="py-10">
	<Container>
		<p class="mb-8 text-center text-sm font-medium text-muted-foreground">
			{t("logoCloud.subtitle")}
		</p>
		<div
			class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6 sm:gap-x-12 lg:gap-x-14"
			data-animate
		>
			{
				integrations.map((brand) => (
					<div
						class:list={[
							"flex items-center gap-2.5 opacity-70 transition-opacity duration-200 hover:opacity-100",
							brand.kind === "apollo" && "gap-0",
						]}
					>
						{brand.kind === "apollo" && <ApolloWordmark size="sm" />}
						{brand.kind === "colored" && (
							<img
								src={brand.icon}
								alt=""
								width="24"
								height="24"
								class="h-6 w-6 shrink-0"
								loading="lazy"
								decoding="async"
							/>
						)}
						{brand.kind === "theme" && (
							<>
								<img
									src={brand.iconDark}
									alt=""
									width="24"
									height="24"
									class="dark-only h-6 w-6 shrink-0"
									loading="lazy"
									decoding="async"
								/>
								<img
									src={brand.iconLight}
									alt=""
									width="24"
									height="24"
									class="light-only h-6 w-6 shrink-0"
									loading="lazy"
									decoding="async"
								/>
							</>
						)}
						{brand.kind !== "apollo" && (
							<span class="text-sm font-semibold text-foreground">{brand.name}</span>
						)}
					</div>
				))
			}
		</div>
	</Container>
</section>

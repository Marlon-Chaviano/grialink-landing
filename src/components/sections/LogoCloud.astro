---
import Container from "@/components/ui/Container.astro";
import ApolloWordmark from "@/components/ui/ApolloWordmark.astro";
import GoHighLevelWordmark from "@/components/ui/GoHighLevelWordmark.astro";
import RingCentralWordmark from "@/components/ui/RingCentralWordmark.astro";
import { type Lang } from "@/i18n/config";
import { useTranslations } from "@/i18n/utils";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

type ColoredBrand = { name: string; kind: "colored"; icon: string };
type ThemeBrand = { name: string; kind: "theme"; iconDark: string; iconLight: string };
type ApolloBrand = { name: string; kind: "apollo" };
type WordmarkBrand = { name: string; kind: "gohighlevel" | "ringcentral" };

/** Brand marks — local SVGs where Simple Icons CDN no longer hosts the brand */
const integrations: Array<ColoredBrand | ThemeBrand | ApolloBrand | WordmarkBrand> = [
	{ name: "WhatsApp", kind: "colored", icon: "https://cdn.simpleicons.org/whatsapp/25D366" },
	{
		name: "Google Calendar",
		kind: "theme",
		iconDark: "/assets/integrations/google-calendar-dark.svg",
		iconLight: "/assets/integrations/google-calendar-light.svg",
	},
	{ name: "Meta Ads", kind: "colored", icon: "/assets/integrations/meta.svg" },
	{ name: "Apollo", kind: "apollo" },
	{ name: "GoHighLevel", kind: "gohighlevel" },
	{ name: "RingCentral", kind: "ringcentral" },
	{ name: "Twilio", kind: "colored", icon: "/assets/integrations/twilio.svg" },
	{ name: "SendGrid", kind: "colored", icon: "/assets/integrations/sendgrid.svg" },
];
---

<section class="py-10 border-y border-border-light/60">
	<Container>
		<p class="mb-2 text-center text-sm font-semibold text-foreground">
			{t("logoCloud.title")}
		</p>
		<p class="mb-8 text-center text-xs font-medium text-muted-foreground">
			{t("logoCloud.subtitle")}
		</p>
		<div
			class="mx-auto grid max-w-3xl grid-cols-2 items-center justify-items-center gap-x-6 gap-y-8 sm:max-w-4xl sm:grid-cols-4 sm:gap-x-8"
			data-animate
		>
			{
				integrations.map((brand) => (
					<div
						class:list={[
							"flex min-w-0 items-center justify-center gap-2.5 px-1 opacity-70 transition-opacity duration-200 hover:opacity-100",
							(brand.kind === "apollo" ||
								brand.kind === "gohighlevel" ||
								brand.kind === "ringcentral") &&
								"gap-0",
						]}
					>
						{brand.kind === "apollo" && <ApolloWordmark size="sm" />}
						{brand.kind === "gohighlevel" && <GoHighLevelWordmark size="sm" />}
						{brand.kind === "ringcentral" && <RingCentralWordmark size="sm" />}
						{brand.kind === "colored" && (
							<img
								src={brand.icon}
								alt=""
								width="24"
								height="24"
								class="h-6 w-6 shrink-0"
								loading="lazy"
								decoding="async"
							/>
						)}
						{brand.kind === "theme" && (
							<>
								<img
									src={brand.iconDark}
									alt=""
									width="24"
									height="24"
									class="dark-only h-6 w-6 shrink-0"
									loading="lazy"
									decoding="async"
								/>
								<img
									src={brand.iconLight}
									alt=""
									width="24"
									height="24"
									class="light-only h-6 w-6 shrink-0"
									loading="lazy"
									decoding="async"
								/>
							</>
						)}
						{brand.kind !== "apollo" &&
							brand.kind !== "gohighlevel" &&
							brand.kind !== "ringcentral" && (
							<span class="text-sm font-semibold text-foreground">{brand.name}</span>
						)}
					</div>
				))
			}
		</div>
	</Container>
</section>

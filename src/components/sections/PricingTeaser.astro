---
import Container from "@/components/ui/Container.astro";
import { type Lang, localizedHref } from "@/i18n/config";
import { getTranslations } from "@/i18n/utils";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslations(lang, "pricingTeaser") as Record<string, unknown>;
const plans = t.plans as Record<string, Record<string, string>>;
const planIds = ["free", "pro", "scale"];
const registerHref = "https://app.grialink.com/app/auth/register";
---

<section class="section-spacing">
	<Container>
		<div class="mx-auto mb-10 max-w-2xl text-center" data-animate>
			<h2 class="mb-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
				{t.title as string}
			</h2>
			<p class="text-base text-muted-foreground lg:text-lg">{t.subtitle as string}</p>
		</div>

		<div class="mx-auto grid max-w-5xl grid-cols-1 gap-4 md:grid-cols-3">
			{
				planIds.map((id) => {
					const plan = plans[id];
					const isFeatured = id === "pro";

					return (
						<div
							class:list={[
								"relative flex flex-col rounded-2xl auth-card p-6 transition-colors duration-200 lg:rounded-3xl lg:p-7",
								isFeatured
									? "border-primary/30 shadow-lg shadow-primary/10"
									: "border-border-light hover:border-primary/15",
							]}
							data-animate
						>
							{plan.badge && (
								<span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-primary px-3 py-1 text-[10px] font-bold uppercase tracking-wide text-primary-foreground">
									{plan.badge}
								</span>
							)}

							<p class="text-sm font-medium text-muted-foreground">{plan.name}</p>
							<p class="mt-2 text-3xl font-bold tracking-tight text-foreground">
								{plan.price}
								<span class="text-sm font-normal text-muted-foreground">{t.perMonth as string}</span>
							</p>
							<p class="mt-3 text-sm text-muted-foreground">{plan.highlight}</p>

							<a
								href={registerHref}
								class:list={[
									"mt-6 inline-flex items-center justify-center rounded-xl px-4 py-2.5 text-sm font-semibold transition-colors duration-200",
									isFeatured
										? "bg-primary text-primary-foreground hover:bg-primary-hover"
										: "border border-border-light text-foreground hover:border-primary/20 hover:bg-surface",
								]}
							>
								{plan.cta}
							</a>
						</div>
					);
				})
			}
		</div>

		<div class="mt-8 flex flex-col items-center gap-3 text-center" data-animate>
			<a
				href={localizedHref("/pricing", lang)}
				class="text-sm font-semibold text-primary transition-colors hover:text-primary-hover"
			>
				{t.seeAll as string}
			</a>
			<p class="text-xs text-muted-foreground">{t.disclaimer as string}</p>
		</div>
	</Container>
</section>

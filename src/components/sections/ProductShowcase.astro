---
/**
 * ProductShowcase — the seven modules, each with its real screen.
 *
 * Drives `ModuleShowcase` from one ordered list. The previous version repeated
 * near-identical markup seven times and hand-built fake dashboards for the
 * modules that had no capture; every module now has one.
 */
import ModuleShowcase from "@/components/sections/ModuleShowcase.astro";
import { type Lang } from "@/i18n/config";
import { getTranslations } from "@/i18n/utils";

import prospectorDark from "@/assets/marketing/captures/prospector-smart-dark.webp";
import prospectorLight from "@/assets/marketing/captures/prospector-smart-light.webp";
import outreachDark from "@/assets/marketing/captures/cadences-dark.webp";
import outreachLight from "@/assets/marketing/captures/cadences-light.webp";
import pipelineDark from "@/assets/marketing/captures/pipeline-dark.webp";
import pipelineLight from "@/assets/marketing/captures/pipeline-light.webp";
import calendarDark from "@/assets/marketing/captures/calendar-dark.webp";
import calendarLight from "@/assets/marketing/captures/calendar-light.webp";
import botsDark from "@/assets/marketing/captures/ivr-builder-dark.webp";
import botsLight from "@/assets/marketing/captures/ivr-builder-light.webp";
import dialerDark from "@/assets/marketing/captures/dialer-calls-dark.webp";
import dialerLight from "@/assets/marketing/captures/dialer-calls-light.webp";
import phoneWhatsapp from "@/assets/marketing/whatsapp-assistant-phone.webp";
import frontDeskReception from "@/assets/marketing/front-desk-reception.webp";
import analyticsDark from "@/assets/marketing/captures/sales-insights-dark.webp";
import analyticsLight from "@/assets/marketing/captures/sales-insights-light.webp";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslations(lang, "productsPage") as Record<string, any>;
const showcase = t.showcase as Record<string, any>;

/** Anchor ids are load-bearing — `productSectionAnchor` links to them. */
const modules = [
	{ key: "prospector", id: "prospector", dark: prospectorDark, light: prospectorLight },
	{ key: "outreach", id: "outreach", dark: outreachDark, light: outreachLight },
	{ key: "pipeline", id: "ses", dark: pipelineDark, light: pipelineLight },
	{ key: "calendar", id: "calendar-detail", dark: calendarDark, light: calendarLight },
	{
		key: "grialBots",
		id: "grial-bots",
		dark: botsDark,
		light: botsLight,
		// Grial Bots covers three surfaces; the two photos carry the WhatsApp
		// assistant and the AI receptionist, and the IVR tree proves them.
		atmosphereKeys: ["whatsapp", "frontDesk"] as const,
	},
	{ key: "dialer", id: "dialer", dark: dialerDark, light: dialerLight },
	{ key: "salesDashboard", id: "sales-dashboard", dark: analyticsDark, light: analyticsLight },
];
---

{
	modules.map((module, i) => {
		const copy = showcase[module.key];
		return (
			<ModuleShowcase
				id={module.id}
				badge={copy.badge}
				title={copy.title}
				subtitle={copy.subtitle}
				featuresTitle={copy.featuresTitle}
				featuresDescription={copy.featuresDescription}
				features={copy.features}
				alt={copy.alt}
				dark={module.dark}
				light={module.light}
				atmosphere={
					module.atmosphereKeys?.map((k) => ({
						src: k === "whatsapp" ? phoneWhatsapp : frontDeskReception,
						alt: copy.atmosphereAlt?.[k] ?? "",
					})) ?? []
				}
				tinted={i % 2 === 1}
			/>
		);
	})
}

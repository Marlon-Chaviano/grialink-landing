---
/**
 * ProductShowcase — Detailed product sections with theme-aware screenshots/demos.
 * Order: Prospector → Outreach → Pipeline → Calendar → Grial Bots → Dialer → AI Analytics Hub
 */
import { Image } from "astro:assets";
import Container from "@/components/ui/Container.astro";
import { type Lang, localizedHref } from "@/i18n/config";
import { getTranslations } from "@/i18n/utils";

/* ── Prospector assets ── */
import prospectorSearch from "@/assets/prospector/prospector-search.png";
import prospectorResults from "@/assets/prospector/prospector-results.png";
import prospectorModal from "@/assets/prospector/prospector-modal.png";
import lightProspectorSearch from "@/assets/prospector/light-prospector-search.png";
import lightProspectorResults from "@/assets/prospector/light-prospector-results.png";
import lightProspectorModal from "@/assets/prospector/light-prospector-modal.png";

/* ── Pipeline assets ── */
import pipelineView from "@/assets/pipeline/pipeline.png";
import pipelineLarge from "@/assets/pipeline/large-pipeline.png";
import lightPipelineView from "@/assets/pipeline/light-pipeline.png";
import lightPipelineLarge from "@/assets/pipeline/light-large-pipeline.png";

/* ── Calendar assets ── */
import calendarCreate from "@/assets/calendar/create-appointment.png";
import lightCalendarCreate from "@/assets/calendar/light-create-appointment.png";

/* ── Sales Hub assets ── */
import salesHub from "@/assets/sales-hub/sales-hub.png";
import lightSalesHub from "@/assets/sales-hub/light-sales-hub.png";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslations(lang, "productsPage") as Record<string, any>;
const showcase = t.showcase as Record<string, any>;

const dialerPreviewKpis = showcase.dialer.previewKpis as { label: string; value: string }[];
const dialerPreviewCalls = showcase.dialer.previewCalls as {
	contact: string;
	meta: string;
	score: number;
}[];
---

<!-- ═══════════════════════════════════════════════
     PRODUCT 1 — PROSPECTOR AI
     ═══════════════════════════════════════════════ -->
<section
	class="section-spacing scroll-mt-28 bg-background relative overflow-hidden"
	id="prospector"
>
	<!-- Decorative -->
	<div
		class="absolute top-20 right-0 w-96 h-96 bg-primary/5 rounded-full blur-3xl pointer-events-none"
		aria-hidden="true"
	>
	</div>

	<Container>
		<!-- Section header -->
		<div
			class="text-center mb-16"
			data-animate
		>
			<div
				class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-semibold uppercase tracking-wider mb-4"
			>
				<svg
					class="w-4 h-4"
					fill="currentColor"
					viewBox="0 0 24 24"
					><path
						d="M10 12a4 4 0 100-8 4 4 0 000 8zm0 2c-4.42 0-8 1.79-8 4v2h12.5M20.59 16.93l-3.54-3.54a5.003 5.003 0 10-1.41 1.41l3.54 3.54 1.41-1.41zM14.5 11a3 3 0 11-6 0 3 3 0 016 0z"
					></path></svg
				>
				{showcase.prospector.badge}
			</div>
			<h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground mb-4">
				{showcase.prospector.title}
			</h2>
			<p class="text-lg text-muted-foreground max-w-3xl mx-auto">
				{showcase.prospector.subtitle}
			</p>
		</div>

		<!-- Step 1: Search -->
		<div
			class="grid lg:grid-cols-2 gap-12 items-center mb-20"
			data-animate
		>
			<div class="order-2 lg:order-1">
				<div class="flex items-center gap-3 mb-4">
					<span class="w-8 h-8 rounded-full bg-primary/20 text-primary font-bold text-sm flex items-center justify-center">1</span>
					<h3 class="text-xl font-bold text-foreground">{showcase.prospector.step1Title}</h3>
				</div>
				<p class="text-muted-foreground leading-relaxed mb-6">
					{showcase.prospector.step1Description}
				</p>
				<ul class="space-y-3">
					{
						(showcase.prospector.step1Features as string[]).map((f: string) => (
							<li class="flex items-start gap-2 text-sm text-muted-foreground">
								<svg
									class="w-5 h-5 text-primary mt-0.5 shrink-0"
									fill="currentColor"
									viewBox="0 0 24 24"
								>
									<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
								</svg>
								<span>{f}</span>
							</li>
						))
					}
				</ul>
			</div>
			<div class="order-1 lg:order-2 relative group">
				<div
					class="absolute -inset-1 bg-gradient-to-r from-primary/20 to-orange-600/20 rounded-2xl blur opacity-0 group-hover:opacity-100 transition-opacity duration-500"
					aria-hidden="true"
				>
				</div>
				<div class="relative rounded-2xl overflow-hidden border border-border shadow-2xl">
					<Image
						src={prospectorSearch}
						alt={showcase.prospector.step1ImageAlt}
						class="w-full h-auto dark-only"
						loading="lazy"
						decoding="async"
						widths={[480, 768, 1024]}
						sizes="(max-width: 1024px) 100vw, 50vw"
					/>
					<Image
						src={lightProspectorSearch}
						alt={showcase.prospector.step1ImageAlt}
						class="w-full h-auto light-only"
						loading="lazy"
						decoding="async"
						widths={[480, 768, 1024]}
						sizes="(max-width: 1024px) 100vw, 50vw"
					/>
				</div>
			</div>
		</div>

		<!-- Step 2: Results -->
		<div
			class="grid lg:grid-cols-2 gap-12 items-center mb-20"
			data-animate
		>
			<div class="relative group">
				<div
					class="absolute -inset-1 bg-gradient-to-r from-primary/20 to-orange-600/20 rounded-2xl blur opacity-0 group-hover:opacity-100 transition-opacity duration-500"
					aria-hidden="true"
				>
				</div>
				<div class="relative rounded-2xl overflow-hidden border border-border shadow-2xl">
					<Image
						src={prospectorResults}
						alt={showcase.prospector.step2ImageAlt}
						class="w-full h-auto dark-only"
						loading="lazy"
						decoding="async"
						widths={[480, 768, 1024]}
						sizes="(max-width: 1024px) 100vw, 50vw"
					/>
					<Image
						src={lightProspectorResults}
						alt={showcase.prospector.step2ImageAlt}
						class="w-full h-auto light-only"
						loading="lazy"
						decoding="async"
						widths={[480, 768, 1024]}
						sizes="(max-width: 1024px) 100vw, 50vw"
					/>
				</div>
			</div>
			<div>
				<div class="flex items-center gap-3 mb-4">
					<span class="w-8 h-8 rounded-full bg-primary/20 text-primary font-bold text-sm flex items-center justify-center">2</span>
					<h3 class="text-xl font-bold text-foreground">{showcase.prospector.step2Title}</h3>
				</div>
				<p class="text-muted-foreground leading-relaxed mb-6">
					{showcase.prospector.step2Description}
				</p>
				<ul class="space-y-3">
					{
						(showcase.prospector.step2Features as string[]).map((f: string) => (
							<li class="flex items-start gap-2 text-sm text-muted-foreground">
								<svg
									class="w-5 h-5 text-primary mt-0.5 shrink-0"
									fill="currentColor"
									viewBox="0 0 24 24"
								>
									<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
								</svg>
								<span>{f}</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<!-- Step 3: Contact detail modal -->
		<div
			class="grid lg:grid-cols-2 gap-12 items-center"
			data-animate
		>
			<div class="order-2 lg:order-1">
				<div class="flex items-center gap-3 mb-4">
					<span class="w-8 h-8 rounded-full bg-primary/20 text-primary font-bold text-sm flex items-center justify-center">3</span>
					<h3 class="text-xl font-bold text-foreground">{showcase.prospector.step3Title}</h3>
				</div>
				<p class="text-muted-foreground leading-relaxed mb-6">
					{showcase.prospector.step3Description}
				</p>
				<ul class="space-y-3">
					{
						(showcase.prospector.step3Features as string[]).map((f: string) => (
							<li class="flex items-start gap-2 text-sm text-muted-foreground">
								<svg
									class="w-5 h-5 text-primary mt-0.5 shrink-0"
									fill="currentColor"
									viewBox="0 0 24 24"
								>
									<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
								</svg>
								<span>{f}</span>
							</li>
						))
					}
				</ul>
			</div>
			<div class="order-1 lg:order-2 relative group">
				<div
					class="absolute -inset-1 bg-gradient-to-r from-primary/20 to-orange-600/20 rounded-2xl blur opacity-0 group-hover:opacity-100 transition-opacity duration-500"
					aria-hidden="true"
				>
				</div>
				<div class="relative rounded-2xl overflow-hidden border border-border shadow-2xl">
					<Image
						src={prospectorModal}
						alt={showcase.prospector.step3ImageAlt}
						class="w-full h-auto dark-only"
						loading="lazy"
						decoding="async"
						widths={[480, 768, 1024]}
						sizes="(max-width: 1024px) 100vw, 50vw"
					/>
					<Image
						src={lightProspectorModal}
						alt={showcase.prospector.step3ImageAlt}
						class="w-full h-auto light-only"
						loading="lazy"
						decoding="async"
						widths={[480, 768, 1024]}
						sizes="(max-width: 1024px) 100vw, 50vw"
					/>
				</div>
			</div>
		</div>

		<!-- Prospector demo video -->
		<div
			class="mt-16 text-center"
			data-animate
		>
			<h3 class="text-xl font-bold text-foreground mb-6">{showcase.prospector.demoTitle}</h3>
			<div class="relative max-w-4xl mx-auto rounded-2xl overflow-hidden border border-border shadow-2xl">
				<video
					class="w-full h-auto dark-only"
					autoplay
					muted
					loop
					playsinline
					preload="metadata"
				>
					<source
						src="/assets/prospector/prospector-demo.mp4"
						type="video/mp4"
					/>
				</video>
				<video
					class="w-full h-auto light-only"
					autoplay
					muted
					loop
					playsinline
					preload="metadata"
				>
					<source
						src="/assets/prospector/light-prospector-demo.mp4"
						type="video/mp4"
					/>
				</video>
			</div>
		</div>
	</Container>
</section>

<!-- ═══════════════════════════════════════════════
     PRODUCT 2 — OUTREACH ENGINE
     ═══════════════════════════════════════════════ -->
<section
	class="section-spacing scroll-mt-28 bg-background-lighter relative overflow-hidden"
	id="outreach"
>
	<div
		class="absolute top-10 right-0 w-96 h-96 bg-accent/5 rounded-full blur-3xl pointer-events-none"
		aria-hidden="true"
	>
	</div>

	<Container>
		<div class="text-center mb-16" data-animate>
			<div
				class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 border border-accent/20 text-accent text-xs font-semibold uppercase tracking-wider mb-4"
			>
				<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"></path>
				</svg>
				{showcase.outreach.badge}
			</div>
			<h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground mb-4">
				{showcase.outreach.title}
			</h2>
			<p class="text-lg text-muted-foreground max-w-3xl mx-auto">
				{showcase.outreach.subtitle}
			</p>
		</div>

		<div class="grid lg:grid-cols-2 gap-12 items-center" data-animate>
			<div>
				<h3 class="text-xl font-bold text-foreground mb-4">{showcase.outreach.featuresTitle}</h3>
				<p class="text-muted-foreground leading-relaxed mb-6">
					{showcase.outreach.featuresDescription}
				</p>
				<ul class="space-y-3">
					{
						(showcase.outreach.features as string[]).map((f: string) => (
							<li class="flex items-start gap-2 text-sm text-muted-foreground">
								<svg
									class="w-5 h-5 text-accent mt-0.5 shrink-0"
									fill="currentColor"
									viewBox="0 0 24 24"
									aria-hidden="true"
								>
									<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
								</svg>
								<span>{f}</span>
							</li>
						))
					}
				</ul>
			</div>
			<div class="relative rounded-2xl overflow-hidden border border-border auth-card shadow-2xl p-5 sm:p-6">
				<div class="mb-4 flex items-center gap-2 border-b border-border-light pb-3">
					<div class="h-2.5 w-2.5 rounded-full bg-red-500/80"></div>
					<div class="h-2.5 w-2.5 rounded-full bg-yellow-500/80"></div>
					<div class="h-2.5 w-2.5 rounded-full bg-green-500/80"></div>
					<span class="ml-auto text-[10px] font-medium text-muted-foreground">Cadences</span>
				</div>
				<div class="space-y-3">
					<div class="rounded-xl border border-border-light bg-background/50 p-4">
						<div class="mb-2 flex items-center justify-between gap-2">
							<span class="text-xs font-semibold text-foreground">Step 1 · Email</span>
							<span class="rounded-full bg-green-500/10 px-2 py-0.5 text-[10px] font-semibold text-green-400">
								AI optimized
							</span>
						</div>
						<p class="text-xs text-muted-foreground line-clamp-2">
							Subject: Quick question about your clinic growth goals
						</p>
					</div>
					<div class="rounded-xl border border-border-light bg-background/50 p-4 opacity-80">
						<div class="mb-2 text-xs font-semibold text-foreground">Step 2 · Follow-up</div>
						<p class="text-xs text-muted-foreground line-clamp-2">
							Scheduled +2 days · open tracking enabled
						</p>
					</div>
					<div class="rounded-xl border border-dashed border-accent/30 bg-accent/5 p-4">
						<div class="flex items-center gap-2 text-xs font-semibold text-accent">
							<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
							</svg>
							Email AI Optimizer
						</div>
					</div>
				</div>
			</div>
		</div>
	</Container>
</section>

<!-- ═══════════════════════════════════════════════
     PRODUCT 3 — SMART PIPELINE
     ═══════════════════════════════════════════════ -->
<section
	class="section-spacing scroll-mt-28 bg-background-lighter relative overflow-hidden"
	id="ses"
>
	<div
		class="absolute bottom-20 left-0 w-96 h-96 bg-purple-500/5 rounded-full blur-3xl pointer-events-none"
		aria-hidden="true"
	>
	</div>

	<Container>
		<div
			class="text-center mb-16"
			data-animate
		>
			<div
				class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs font-semibold uppercase tracking-wider mb-4"
			>
				<svg
					class="w-4 h-4"
					fill="currentColor"
					viewBox="0 0 24 24"
					><path
						d="M9.78 11.16l-1.42 1.42a7.282 7.282 0 01-1.79-2.94l1.94-.49c.32.89.77 1.5 1.27 2.01zM11 6L7 2 3 6h3.02c.02.81.08 1.54.19 2.17l1.94-.49C8.08 7.2 8.03 6.63 8.02 6H11zm10 0l-4-4-4 4h3.02c-.02.81-.08 1.54-.19 2.17l-1.94-.49c.07-.48.12-1.05.13-1.68H18z"
					></path></svg
				>
				{showcase.pipeline.badge}
			</div>
			<h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground mb-4">
				{showcase.pipeline.title}
			</h2>
			<p class="text-lg text-muted-foreground max-w-3xl mx-auto">
				{showcase.pipeline.subtitle}
			</p>
		</div>

		<!-- Pipeline view -->
		<div
			class="grid lg:grid-cols-2 gap-12 items-center mb-20"
			data-animate
		>
			<div>
				<h3 class="text-xl font-bold text-foreground mb-4">{showcase.pipeline.viewTitle}</h3>
				<p class="text-muted-foreground leading-relaxed mb-6">
					{showcase.pipeline.viewDescription}
				</p>
				<ul class="space-y-3">
					{
						(showcase.pipeline.viewFeatures as string[]).map((f: string) => (
							<li class="flex items-start gap-2 text-sm text-muted-foreground">
								<svg
									class="w-5 h-5 text-purple-400 mt-0.5 shrink-0"
									fill="currentColor"
									viewBox="0 0 24 24"
								>
									<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
								</svg>
								<span>{f}</span>
							</li>
						))
					}
				</ul>
			</div>
			<div class="relative group">
				<div
					class="absolute -inset-1 bg-gradient-to-r from-purple-500/20 to-purple-600/20 rounded-2xl blur opacity-0 group-hover:opacity-100 transition-opacity duration-500"
					aria-hidden="true"
				>
				</div>
				<div class="relative rounded-2xl overflow-hidden border border-border shadow-2xl">
					<Image
						src={pipelineView}
						alt={showcase.pipeline.viewImageAlt}
						class="w-full h-auto dark-only"
						loading="lazy"
						decoding="async"
						widths={[480, 768, 1024]}
						sizes="(max-width: 1024px) 100vw, 50vw"
					/>
					<Image
						src={lightPipelineView}
						alt={showcase.pipeline.viewImageAlt}
						class="w-full h-auto light-only"
						loading="lazy"
						decoding="async"
						widths={[480, 768, 1024]}
						sizes="(max-width: 1024px) 100vw, 50vw"
					/>
				</div>
			</div>
		</div>

		<!-- Full pipeline expanded -->
		<div
			class="mb-16"
			data-animate
		>
			<h3 class="text-xl font-bold text-foreground mb-4 text-center">{showcase.pipeline.expandedTitle}</h3>
			<p class="text-muted-foreground text-center max-w-2xl mx-auto mb-8">
				{showcase.pipeline.expandedDescription}
			</p>
			<div class="relative group max-w-6xl mx-auto">
				<div
					class="absolute -inset-1 bg-gradient-to-r from-purple-500/10 to-purple-600/10 rounded-2xl blur opacity-0 group-hover:opacity-100 transition-opacity duration-500"
					aria-hidden="true"
				>
				</div>
				<div class="relative rounded-2xl overflow-hidden border border-border shadow-2xl overflow-x-auto">
					<Image
						src={pipelineLarge}
						alt={showcase.pipeline.expandedImageAlt}
						class="w-full h-auto min-w-[800px] dark-only"
						loading="lazy"
						decoding="async"
						widths={[800, 1200, 1600]}
						sizes="(max-width: 1024px) 800px, 100vw"
					/>
					<Image
						src={lightPipelineLarge}
						alt={showcase.pipeline.expandedImageAlt}
						class="w-full h-auto min-w-[800px] light-only"
						loading="lazy"
						decoding="async"
						widths={[800, 1200, 1600]}
						sizes="(max-width: 1024px) 800px, 100vw"
					/>
				</div>
			</div>
		</div>

		<!-- Pipeline demo video -->
		<div
			class="text-center"
			data-animate
		>
			<h3 class="text-xl font-bold text-foreground mb-6">{showcase.pipeline.demoTitle}</h3>
			<div class="relative max-w-4xl mx-auto rounded-2xl overflow-hidden border border-border shadow-2xl">
				<video
					class="w-full h-auto dark-only"
					autoplay
					muted
					loop
					playsinline
					preload="metadata"
				>
					<source
						src="/assets/pipeline/pipeline.mp4"
						type="video/mp4"
					/>
				</video>
				<video
					class="w-full h-auto light-only"
					autoplay
					muted
					loop
					playsinline
					preload="metadata"
				>
					<source
						src="/assets/pipeline/light-pipeline.mp4"
						type="video/mp4"
					/>
				</video>
			</div>
		</div>
	</Container>
</section>

<!-- ═══════════════════════════════════════════════
     PRODUCT 3 — SMART CALENDAR
     ═══════════════════════════════════════════════ -->
<section
	class="section-spacing bg-background relative overflow-hidden"
	id="calendar-detail"
>
	<div
		class="absolute top-10 left-0 w-96 h-96 bg-blue-500/5 rounded-full blur-3xl pointer-events-none"
		aria-hidden="true"
	>
	</div>

	<Container>
		<div
			class="text-center mb-16"
			data-animate
		>
			<div
				class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold uppercase tracking-wider mb-4"
			>
				<svg

---
/**
 * The "Product" navigation entry — a trigger plus a mega-menu panel.
 *
 * Interaction rules (all four input methods have to work):
 *   • Pointer  — hover opens, but only behind `(hover: hover) and (pointer: fine)`
 *                so a touch tap does not leave a stuck hover state.
 *   • Click    — always toggles, on every device.
 *   • Keyboard — Enter/Space/ArrowDown open, arrows move between items, Escape
 *                closes and returns focus to the trigger.
 *   • Focus    — leaving the wrapper closes the panel, so tabbing past it behaves.
 *
 * The panel is absolutely positioned and pointer-events-gated rather than
 * mounted/unmounted, so opening it never reflows the header (no layout shift)
 * and the fade cannot flicker.
 *
 * Items come from `src/lib/productMenu.ts` — shared with the mobile accordion in
 * `Navbar.astro` so the two lists cannot drift.
 */
import { type Lang, localizedHref } from "@/i18n/config";
import { getTranslations } from "@/i18n/utils";
import GrialCupIcon from "@/components/ui/GrialCupIcon.astro";
import { productMenuGroups } from "@/lib/productMenu";

interface Props {
	lang: Lang;
	nav: Record<string, any>;
	/** True on /products and any /products/<slug>. */
	current: boolean;
}

const { lang, nav, current } = Astro.props;
const menu = nav.productMenu as Record<string, any>;
/* Product names live with the catalogue so the menu, /products and each page
   always say the same thing. */
const catalogue = getTranslations(lang, "productsCatalogue") as Record<string, any>;

const groups = productMenuGroups.map((group) => ({
	key: group.key,
	label: menu.groups[group.key] as string,
	entries: group.entries.map((entry) => ({
		...entry,
		href: localizedHref(`/products/${entry.slug}`, lang),
		name: catalogue.items[entry.slug].name as string,
		description: menu.items[entry.slug] as string,
	})),
}));

const allProductsHref = localizedHref("/products", lang);
---

<div class="products-menu relative" data-products-menu>
	<button
		type="button"
		id="products-menu-trigger"
		class:list={[
			"flex items-center gap-1 text-sm font-medium transition-colors",
			current ? "text-primary" : "text-muted-foreground hover:text-primary",
		]}
		aria-expanded="false"
		aria-haspopup="true"
		aria-controls="products-menu-panel"
		aria-current={current ? "page" : undefined}
	>
		{nav.product}
		<svg
			class="products-menu-chevron h-4 w-4 transition-transform duration-200"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<path d="M6 9l6 6 6-6"></path>
		</svg>
	</button>

	<div
		id="products-menu-panel"
		role="group"
		aria-labelledby="products-menu-trigger"
		class="products-menu-panel absolute left-0 top-full z-50 w-[min(44rem,calc(100vw-3rem))] pt-3"
	>
		<div
			class="overflow-hidden rounded-2xl border border-border-light bg-background shadow-2xl shadow-black/25"
		>
			<div class="p-3">
				{
					groups.map((group, gi) => (
						<div class:list={[gi > 0 && "mt-3 border-t border-border-light pt-3"]}>
							<p class="px-3 pb-1.5 pt-1 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
								{group.label}
							</p>
							<div class="grid gap-x-2 sm:grid-cols-2">
								{group.entries.map(item => (
									<a
										href={item.href}
										class:list={[
											"products-menu-item group flex items-start gap-3 rounded-xl p-2.5 transition-colors",
											item.featured
												? "hover:bg-primary/10"
												: "hover:bg-surface",
										]}
									>
										{group.key === "agents" ? (
											<GrialCupIcon iconPath={item.iconPath} class="mt-0.5 size-8" />
										) : (
											<svg
													class="mt-0.5 size-7 shrink-0 text-muted-foreground transition-colors group-hover:text-primary"
													viewBox="0 0 24 24"
													fill="none"
													stroke="currentColor"
													stroke-width="1.55"
													stroke-linecap="round"
													stroke-linejoin="round"
													aria-hidden="true"
												>
													<path d={item.iconPath} />
												</svg>
										)}
										<span class="min-w-0">
											<span class="block text-sm font-semibold text-foreground group-hover:text-primary">
												{item.name}
											</span>
											<span class="mt-0.5 block text-xs leading-snug text-muted-foreground">
												{item.description}
											</span>
										</span>
									</a>
								))}
							</div>
						</div>
					))
				}
			</div>

			<a
				href={allProductsHref}
				class="products-menu-item group flex items-center justify-between gap-4 border-t border-border-light bg-surface px-6 py-3.5 transition-colors hover:bg-primary/5"
			>
				<span class="min-w-0">
					<span class="block text-sm font-semibold text-foreground group-hover:text-primary">
						{menu.seeAll}
					</span>
					<span class="mt-0.5 block text-xs text-muted-foreground">{menu.seeAllHint}</span>
				</span>
				<svg
					class="h-4 w-4 shrink-0 text-primary transition-transform group-hover:translate-x-1"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M5 12h14M13 6l6 6-6 6"></path>
				</svg>
			</a>
		</div>
	</div>
</div>

<style>
	/* Gated rather than unmounted: the panel keeps its box so opening it cannot
	   reflow the header, and the transition has something stable to animate. */
	.products-menu-panel {
		opacity: 0;
		visibility: hidden;
		transform: translateY(-0.375rem);
		transition:
			opacity 180ms ease,
			transform 180ms ease,
			visibility 0s linear 180ms;
	}

	.products-menu[data-open] .products-menu-panel {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
		transition:
			opacity 180ms ease,
			transform 180ms ease,
			visibility 0s;
	}

	.products-menu[data-open] .products-menu-chevron {
		transform: rotate(180deg);
	}

	@media (prefers-reduced-motion: reduce) {
		.products-menu-panel,
		.products-menu-chevron {
			transition: none;
		}
	}
</style>

<script>
	const wrapper = document.querySelector<HTMLElement>("[data-products-menu]");
	const trigger = document.getElementById("products-menu-trigger");
	const panel = document.getElementById("products-menu-panel");

	if (wrapper && trigger && panel) {
		const items = () => Array.from(panel.querySelectorAll<HTMLAnchorElement>(".products-menu-item"));
		let closeTimer: number | undefined;
		/*
		 * "Pinned" = opened deliberately, by click or keyboard, rather than by
		 * hovering past it. Without this distinction a mouse user who hovers the
		 * trigger (opening it) and then *clicks* it would toggle it straight shut
		 * — the menu appears to vanish on click, which is the opposite of what
		 * clicking should do. Pinned menus also survive pointerleave.
		 */
		let pinned = false;

		const cancelClose = () => {
			if (closeTimer !== undefined) {
				window.clearTimeout(closeTimer);
				closeTimer = undefined;
			}
		};

		const open = () => {
			cancelClose();
			wrapper.setAttribute("data-open", "");
			trigger.setAttribute("aria-expanded", "true");
		};

		const close = () => {
			cancelClose();
			pinned = false;
			wrapper.removeAttribute("data-open");
			trigger.setAttribute("aria-expanded", "false");
		};

		const isOpen = () => trigger.getAttribute("aria-expanded") === "true";

		/* Crossing the gap between trigger and panel briefly leaves both, so the
		   close is deferred long enough to survive the handoff. */
		const scheduleClose = () => {
			cancelClose();
			closeTimer = window.setTimeout(close, 120);
		};

		trigger.addEventListener("click", () => {
			if (pinned) {
				close();
			} else {
				pinned = true;
				open();
			}
		});

		/* Hover only where hovering is real — a touch tap must not open-then-stick. */
		const canHover = window.matchMedia("(hover: hover) and (pointer: fine)");
		wrapper.addEventListener("pointerenter", (e) => {
			if (e.pointerType === "touch" || !canHover.matches) return;
			open();
		});
		wrapper.addEventListener("pointerleave", (e) => {
			if (e.pointerType === "touch" || !canHover.matches || pinned) return;
			scheduleClose();
		});

		trigger.addEventListener("keydown", (e) => {
			if (e.key === "ArrowDown") {
				e.preventDefault();
				pinned = true;
				open();
				items()[0]?.focus();
			}
		});

		panel.addEventListener("keydown", (e) => {
			if (e.key !== "ArrowDown" && e.key !== "ArrowUp") return;
			e.preventDefault();
			const list = items();
			const index = list.indexOf(document.activeElement as HTMLAnchorElement);
			const next = e.key === "ArrowDown" ? index + 1 : index - 1;
			if (next < 0) {
				trigger.focus();
			} else {
				list[Math.min(next, list.length - 1)]?.focus();
			}
		});

		wrapper.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && isOpen()) {
				close();
				trigger.focus();
			}
		});

		/* Tabbing out of the menu closes it; focus moving *within* it does not. */
		wrapper.addEventListener("focusout", (e) => {
			if (!wrapper.contains(e.relatedTarget as Node)) close();
		});

		document.addEventListener("pointerdown", (e) => {
			if (isOpen() && !wrapper.contains(e.target as Node)) close();
		});
	}
</script>

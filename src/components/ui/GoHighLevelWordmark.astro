---
interface Props {
	size?: 'sm' | 'md' | 'lg';
	class?: string;
}

const { size = 'sm', class: className } = Astro.props;

const heightClass = {
	sm: 'h-4',
	md: 'h-7',
	lg: 'h-8',
}[size];

const maxWidthClass = {
	sm: 'max-w-[5rem]',
	md: 'max-w-[9.5rem]',
	lg: 'max-w-[9.5rem]',
}[size];
---

<div class:list={['inline-flex items-center', className]}>
	<img
		src="/assets/integrations/gohighlevel-dark.svg"
		alt="GoHighLevel"
		class:list={[heightClass, maxWidthClass, 'hidden h-auto shrink-0 object-contain dark-only']}
		loading="lazy"
		decoding="async"
	/>
	<img
		src="/assets/integrations/gohighlevel-light.svg"
		alt="GoHighLevel"
		class:list={[heightClass, maxWidthClass, 'h-auto shrink-0 object-contain light-only']}
		loading="lazy"
		decoding="async"
	/>
</div>

---
/**
 * The single frame used for every product visual on the site.
 *
 * Real screenshots (`ProductPreview`) and hand-built mockups (`components/mockups/*`)
 * both render inside this, so a CSS mockup and a captured dashboard read as the same
 * class of artefact rather than two competing visual languages.
 */
interface Props {
	/** Drops the amber bloom for frames sitting on an already-lit background. */
	bloom?: boolean;
	/** Renders below the frame. */
	caption?: string;
	/** Skips the scroll-reveal when the parent already animates. */
	animate?: boolean;
	class?: string;
	/** Applied to the clipping element — use for a fixed aspect ratio. */
	frameClass?: string;
}

const {
	bloom = true,
	caption,
	animate = true,
	class: className,
	frameClass,
} = Astro.props;
---

<figure class:list={["relative", className]} data-animate={animate ? "" : null}>
	{
		bloom && (
			<div
				class="pointer-events-none absolute -inset-x-8 -bottom-6 -top-8 -z-10 rounded-[2rem] bg-primary/10 blur-3xl"
				aria-hidden="true"
			/>
		)
	}

	<div
		class:list={[
			"overflow-hidden rounded-xl shadow-2xl shadow-black/25 ring-1 ring-border-light lg:rounded-2xl",
			frameClass,
		]}
	>
		<slot />
	</div>

	{
		caption && (
			<figcaption class="mt-4 text-center text-sm text-muted-foreground">{caption}</figcaption>
		)
	}
</figure>

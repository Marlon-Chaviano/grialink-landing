---
/**
 * Frames a real dashboard capture. Ships the dark and light pair and lets the
 * `.dark-only` / `.light-only` utilities swap them, so the screenshot always
 * matches the theme the visitor is reading in.
 *
 * The frame itself lives in `MockupFrame` so captures and hand-built mockups
 * share one visual treatment.
 */
import { Image } from "astro:assets";
import MockupFrame from "@/components/ui/MockupFrame.astro";

interface Props {
	dark: ImageMetadata;
	light: ImageMetadata;
	/** Describes what the screen shows — never leave this empty, it is the alt text. */
	alt: string;
	/** Renders below the frame as a caption. */
	caption?: string;
	/** Eager-load when the preview sits high enough to be the LCP element. */
	eager?: boolean;
	class?: string;
}

const { dark, light, alt, caption, eager = false, class: className } = Astro.props;

const imageClass =
	"w-full rounded-[inherit] border border-border-light bg-card object-cover object-top";
const sizes = "(min-width: 1280px) 1100px, (min-width: 768px) 90vw, 100vw";
const widths = [640, 960, 1280, 1600];
---

<MockupFrame caption={caption} class={className}>
	<Image
		src={dark}
		alt={alt}
		class:list={[imageClass, "dark-only"]}
		widths={widths}
		sizes={sizes}
		loading={eager ? "eager" : "lazy"}
	/>
	<Image
		src={light}
		alt={alt}
		class:list={[imageClass, "light-only"]}
		widths={widths}
		sizes={sizes}
		loading={eager ? "eager" : "lazy"}
	/>
</MockupFrame>

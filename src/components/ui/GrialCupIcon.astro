---
/**
 * The Grial brand mark: the grail cup silhouette with a glyph inside it.
 *
 * Ported from the app (`components-next/icon/GrialCupIcon.vue`) so a Grial Bot
 * is recognisable as the same product on the marketing site and inside the
 * dashboard. The cup path and the 40% / 36% optical placement of the inner
 * glyph are copied verbatim — the bowl sits above the stem, so the glyph is
 * centred optically rather than geometrically.
 *
 * Size comes from the parent (e.g. `class="size-10"`). Do not set size-full on
 * the root.
 */
interface Props {
	/** Stroke-based 24×24 SVG path for the glyph inside the cup. */
	iconPath?: string;
	/** Cup fill. Defaults to the brand orange used by the app's Logo. */
	cupClass?: string;
	class?: string;
}

const { iconPath, cupClass = "fill-[#FD7100]", class: className } = Astro.props;
---

<span
	class:list={["relative inline-flex shrink-0 items-center justify-center", className]}
	aria-hidden="true"
>
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" fill="none" class="size-full">
		<path
			class={cupClass}
			d="M180.81,50.25c-1.71-12.62-6.37-30.78-6.37-30.78h-74.44s-74.44,0-74.44,0c0,0-4.65,18.17-6.37,30.78-1.71,12.62-3.63,28.04-.98,43.65,8.82,51.89,54.85,56.27,54.85,56.27,0,0,.22,30.78-.24,37.85-.83,12.61-7.21,18.88-13.98,21.96-5.65,2.57-4.65,10.88,1.49,11.79.16.02.32.05.49.07,12.59,1.69,65.77,1.69,78.36,0,.17-.02.35-.05.52-.07,6.14-.92,7.15-9.21,1.5-11.78-6.76-3.08-13.14-9.35-14.01-21.95-.45-6.55-.24-37.85-.24-37.85,0,0,46.04-4.37,54.85-56.27,2.65-15.61.73-31.03-.98-43.65Z"
		></path>
	</svg>

	{
		iconPath && (
			<svg
				class="pointer-events-none absolute left-1/2 top-[40%] size-[36%] -translate-x-1/2 -translate-y-1/2 text-white"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2.2"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<path d={iconPath} />
			</svg>
		)
	}
</span>

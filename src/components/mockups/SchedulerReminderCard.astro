---
/**
 * Grial Scheduler — hand-built reminder outcome.
 *
 * Shows both delivery channels, then follows the voice path through to the
 * result that matters: the client reschedules and the calendar updates itself.
 * It is static, theme-aware HTML so it stays legible, localised and JS-free.
 */
import { type Lang } from "@/i18n/config";
import { getTranslations } from "@/i18n/utils";

interface Props {
	lang: Lang;
	class?: string;
}

const { lang, class: className } = Astro.props;
const c = (getTranslations(lang, "mockups") as Record<string, any>).scheduler;
---

<div
	class:list={["flex flex-col bg-card text-left", className]}
	role="img"
	aria-label={c.alt}
>
	{/* Appointment being protected */}
	<div class="flex items-start justify-between gap-4 border-b border-border-light px-4 py-4 sm:px-5">
		<div class="flex min-w-0 items-center gap-3">
			<span
				class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-primary/12 text-primary"
				aria-hidden="true"
			>
				<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
					<path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V6a2 2 0 012-2z"></path>
				</svg>
			</span>
			<div class="min-w-0">
				<p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">{c.eyebrow}</p>
				<p class="truncate text-sm font-semibold text-foreground">{c.title}</p>
				<p class="mt-0.5 text-[11px] text-muted-foreground">{c.appointment}</p>
			</div>
		</div>
		<span class="shrink-0 rounded-full bg-surface px-2.5 py-1 text-[10px] font-semibold text-muted-foreground">
			{c.pending}
		</span>
	</div>

	{/* The two supported delivery paths */}
	<div class="grid grid-cols-2 gap-2.5 border-b border-border-light bg-surface px-4 py-3 sm:px-5">
		<div class="flex items-center gap-2 rounded-lg border border-border-light bg-card px-3 py-2">
			<svg class="size-4 shrink-0 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M3 5h18v14H3zM3 7l9 6 9-6"></path>
			</svg>
			<span class="min-w-0">
				<span class="block text-[11px] font-semibold text-foreground">{c.email.title}</span>
				<span class="block truncate text-[10px] text-muted-foreground">{c.email.note}</span>
			</span>
		</div>
		<div class="relative flex items-center gap-2 rounded-lg border border-primary/30 bg-primary/8 px-3 py-2">
			<span class="absolute right-2 top-2 size-1.5 animate-pulse rounded-full bg-primary" aria-hidden="true"></span>
			<svg class="size-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M4 4h4l2 5-3 2a15 15 0 006 6l2-3 5 2v4a2 2 0 01-2 2C9.16 22 2 14.84 2 6a2 2 0 012-2z"></path>
			</svg>
			<span class="min-w-0">
				<span class="block text-[11px] font-semibold text-primary">{c.voice.title}</span>
				<span class="block truncate text-[10px] text-muted-foreground">{c.voice.note}</span>
			</span>
		</div>
	</div>

	{/* Short call transcript: enough to prove that voice is conversational. */}
	<div class="flex-1 px-4 py-3.5 sm:px-5">
		<p class="mb-2.5 flex items-center justify-between gap-3 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
			<span>{c.transcriptLabel}</span>
			<span class="font-medium normal-case tracking-normal text-primary">{c.timer}</span>
		</p>
		<ul class="space-y-2.5">
			{c.lines.map((line: { speaker: string; name: string; text: string }) => (
				<li class="flex gap-2.5">
					<span
						class:list={[
							"mt-1.5 size-1.5 shrink-0 rounded-full",
							line.speaker === "agent" ? "bg-primary" : "bg-muted-foreground/45",
						]}
						aria-hidden="true"
					></span>
					<span>
						<span class:list={["block text-[10px] font-semibold uppercase tracking-wider", line.speaker === "agent" ? "text-primary" : "text-muted-foreground"]}>
							{line.name}
						</span>
						<span class="mt-0.5 block text-[12px] leading-snug text-foreground">{line.text}</span>
					</span>
				</li>
			))}
		</ul>
	</div>

	{/* Outcome and delivery fallback */}
	<div class="border-t border-primary/20 bg-primary/8 px-4 py-3 sm:px-5">
		<div class="flex flex-wrap items-center justify-between gap-2">
			<p class="flex items-center gap-2 text-[13px] font-semibold text-primary">
				<svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M20 6L9 17l-5-5"></path>
				</svg>
				{c.outcome}
			</p>
			<p class="text-[10px] text-muted-foreground">{c.outcomeNote}</p>
		</div>
		<p class="mt-2 border-t border-primary/15 pt-2 text-[10px] leading-relaxed text-muted-foreground">{c.fallback}</p>
	</div>
</div>

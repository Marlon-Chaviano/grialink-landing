---
import "@/styles/global.css";
import type { Lang } from "@/i18n/config";
import Navbar from "@/components/layout/Navbar.astro";
import Footer from "@/components/layout/Footer.astro";
import CircuitPageBackground from "@/components/background/CircuitPageBackground.astro";
import Analytics from "@/components/seo/Analytics.astro";

interface Props {
	lang: Lang;
	class?: string;
	/** Hide navbar (e.g. 404, minimal pages) */
	noNav?: boolean;
	/** Hide footer */
	noFooter?: boolean;
	/** Circuit background variant (`none` disables the fixed page backdrop). */
	circuitVariant?: 'hero' | 'full' | 'none';
	/** Page opens on a permanently dark hero band — the header adapts while unscrolled. */
	darkHero?: boolean;
}

const {
	lang,
	class: className,
	noNav = false,
	noFooter = false,
	circuitVariant = 'hero',
	darkHero = false,
} = Astro.props;
---

<!doctype html>
<html
	lang={lang}
	class="dark"
>
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0"
		/>
		<meta
			name="generator"
			content={Astro.generator}
		/>

		<!-- Fonts — self-hosted variable woff2, no third-party round-trip -->
		<link
			rel="preload"
			href="/fonts/satoshi-variable.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/switzer-variable.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>

		<slot name="head" />
		<Analytics />

		<!-- Theme initialisation (avoid FOUC) -->
		<script is:inline>
			(function () {
				var s = localStorage.getItem("theme");
				var d = s === "dark" || (!s && matchMedia("(prefers-color-scheme:dark)").matches);
				document.documentElement.classList.toggle("light", !d);
				document.documentElement.classList.toggle("dark", d);
			})();
		</script>

		{/* Scroll-reveal starts at opacity:0 and is un-hidden by JS. Without JS
		    that never fires, which would serve the legal and SMS opt-in pages
		    blank to crawlers and compliance reviewers. */}
		<noscript>
			<style>
				[data-animate],
				.stagger-children > * {
					opacity: 1 !important;
					transform: none !important;
				}
			</style>
		</noscript>
	</head>
	<body class:list={["bg-background text-foreground antialiased", className]}>
		{circuitVariant !== 'none' && (
			<CircuitPageBackground variant={circuitVariant} />
		)}

		<!-- Skip to content — keyboard a11y -->
		<a
			href="#main-content"
			class="skip-to-content relative z-20"
		>
			{lang === "es" ? "Ir al contenido principal" : "Skip to main content"}
		</a>

		{!noNav && <Navbar lang={lang} overDarkHero={darkHero} />}

		<div id="main-content" class="relative z-10">
			<slot />
		</div>

		{!noFooter && <Footer lang={lang} />}

		<script>
			// Scroll-triggered reveal animations (respects reduced motion)
			const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

			const scrollToLocationHash = () => {
				const raw = window.location.hash.slice(1);
				if (!raw) return;

				const id = decodeURIComponent(raw);
				const target = document.getElementById(id);
				if (!target) return;

				const header = document.getElementById("site-header");
				const offset = (header?.offsetHeight ?? 64) + 16;
				const top = target.getBoundingClientRect().top + window.scrollY - offset;

				window.scrollTo({
					top: Math.max(0, top),
					behavior: prefersReducedMotion ? "auto" : "smooth",
				});
			};

			const runHashScroll = () => {
				requestAnimationFrame(() => {
					scrollToLocationHash();
					window.setTimeout(scrollToLocationHash, 150);
				});
			};

			if (prefersReducedMotion) {
				document.querySelectorAll("[data-animate]").forEach((el) => {
					el.classList.add("is-visible");
				});
			} else {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add("is-visible");
								observer.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.08, rootMargin: "0px 0px -40px 0px" },
				);

				document.querySelectorAll("[data-animate]").forEach((el) => {
					observer.observe(el);
				});
			}

			window.addEventListener("DOMContentLoaded", runHashScroll);
			window.addEventListener("load", runHashScroll);
			window.addEventListener("hashchange", scrollToLocationHash);
		</script>

		<!-- Chatwoot live chat -->
		<script is:inline>
			(function (d, t) {
				var BASE_URL = "https://app.grialink.com";
				var g = d.createElement(t),
					s = d.getElementsByTagName(t)[0];
				g.src = BASE_URL + "/packs/js/sdk.js";
				g.async = true;
				s.parentNode.insertBefore(g, s);
				g.onload = function () {
					window.chatwootSDK.run({
						websiteToken: "NLwCp3aUkuV5jVCUcv7Xzmdv",
						baseUrl: BASE_URL,
					});
				};
			})(document, "script");
		</script>
	</body>
</html>
